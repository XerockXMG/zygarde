# Zygarde settings. Copy this file to .env and fill it in.
#
# Each setting is marked Required or Optional. Only DRAGONITE_URL is always
# required, and ORIGIN is required in production. Leave an optional setting
# empty and the feature that needs it is simply turned off, or its default
# is used.
#
# Discord IDs: turn on Developer Mode in Discord (User Settings > Advanced),
# then right-click a server, role or user and choose "Copy ID".
#
# Role lists are comma-separated Discord role IDs. A role counts no matter
# which server it belongs to, as long as that server is in DISCORD_GUILD_IDS.
# A server's own ID counts as a role every member of that server has.
# Admins (ADMIN_DISCORD_IDS) can always see and do everything.
#
# Roles are read when someone logs in, so role changes apply at their next
# login (a login lasts 24 hours).

# ── Server ───────────────────────────────────────────────────────────────────

# Optional. Port the server listens on with `npm run start` or Docker.
# Default 3000.
PORT=3000

# Optional. How much to log: fatal, error, warn, info, debug or trace.
# Default info.
LOG_LEVEL=info

# Required in production. The public address of the site, with no trailing
# slash. Behind a reverse proxy, form submissions are rejected without it. It's also used for the Discord login callback and for links in Discord
# messages. `npm run dev` ignores it.
ORIGIN="https://areas.example.com"

# Optional. Name shown at the top left of every page. Default "Scanner Areas".
SITE_NAME="Scanner Areas"

# Optional. Custom favicon: absolute path to an .ico, .png, .svg, .gif, .jpg
# or .webp file. In Docker, mount the file into the container at this path. Leave
# empty to use the built-in icon.
FAVICON_PATH=""

# Optional. Where the map opens: latitude, longitude and zoom (0-22). The map
# then zooms to fit every area, so this mostly shows for a moment on load, or when there
# are no areas yet. Leave empty for a world view (20, 0, zoom 2).
START_LAT=""
START_LON=""
START_ZOOM=""

# Optional. Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty
# for no analytics.
GA_MEASUREMENT_ID=""

# ── Dragonite ────────────────────────────────────────────────────────────────

# Required. Dragonite's API address. The app shows an error page if this is
# unset or unreachable.
DRAGONITE_URL="http://127.0.0.1:7272"

# Optional. Quest check hours for areas created by approving an area request:
# the hours of the day (0-23, comma-separated) at which Dragonite checks for quest
# changes, starting a quest scan if it finds any. Default 1,10, meaning a
# check at 1:00 and another at 10:00 (not a scan running from 1 to 10).
DEFAULT_QUEST_HOURS=""

# ── Database ─────────────────────────────────────────────────────────────────

# Optional, but recommended. MySQL or MariaDB database for Zygarde's own
# data. Tables are created automatically on start. Needed for voting, tiers, area requests, geofence
# history, autoscale and the admin settings pages. Without it those features
# are off, and logins only last until the next restart.
# Example: mysql://zygarde:password@127.0.0.1:3306/zygarde
LOCAL_DATABASE_URL=""

# ── Discord login ────────────────────────────────────────────────────────────

# Optional, but nobody can log in without these four (client ID, secret, bot
# token and servers), so voting and admin access need them too.
#
# From your application at https://discord.com/developers/applications,
# on the OAuth2 page.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Optional. On that same OAuth2 page, add <ORIGIN>/auth/discord/callback under
# Redirects (and http://localhost:5173/auth/discord/callback for local
# development). Only set this to use a different callback address.
DISCORD_REDIRECT_URI=""

# The application's bot token, from its Bot page. Add the bot to every server
# in DISCORD_GUILD_IDS. It needs no permissions and no privileged intents:
# it only looks up the roles of whoever logs in.
DISCORD_BOT_TOKEN=""

# The servers whose roles count, comma-separated. Roles from any other server
# are ignored.
DISCORD_GUILD_IDS=""

# ── Who can see what ─────────────────────────────────────────────────────────

# Optional. Discord user IDs with full admin access, comma-separated. Leave
# empty for no admins.
ADMIN_DISCORD_IDS=""

# Optional. Role lists that let non-admins see more. Leave empty for admins
# only.
# See disabled areas, not just enabled ones:
OFFLINE_AREA_ACCESS=""
# See the Pokémon, fort and quest route layers on the map:
ROUTE_ACCESS=""
# See spawnpoint counts (needs GOLBAT_DATABASE_URL):
SPAWNPOINT_ACCESS=""

# ── Voting tiers ─────────────────────────────────────────────────────────────

# Optional. Each tier has a name, a weight (the number of tokens its members can put on
# areas) and the roles that grant it. A user gets the highest-weight tier they
# have a role for; anyone matching no tier gets 0 tokens. Admins can override
# a user's tier on /admin/tiers. Leave empty to give everyone who logs in
# 1 token.
#
# Example: every member of server 111111111111111111 gets the Free tier
# (1 token), and anyone with role 555555555555555555 gets VIP (3 tokens):
# VOTE_TIERS='[{"name":"Free","weight":1,"roles":["111111111111111111"]},{"name":"VIP","weight":3,"roles":["555555555555555555"]}]'
VOTE_TIERS=""

# ── Subscription check ───────────────────────────────────────────────────────

# Optional. Role list for paid tiers that should lapse. Once a day, every user
# with tokens and no admin override is checked; anyone who has had none of
# these roles for longer than the grace period (set on /admin/tiers, default
# 7 days) drops to 0 tokens, and their tokens come off their areas. Needs
# DISCORD_BOT_TOKEN and LOCAL_DATABASE_URL. Don't use it alongside a free
# tier like Free in the example above: free users don't hold these roles, so
# they'd lose their tokens too. Leave empty to turn the check off.
SUBSCRIPTION_REQUIRED_ROLES=""

# ── Kōji (route generation and geofences) ────────────────────────────────────

# Optional. Kōji's address. Needed for route generation, for creating a Kōji geofence
# when approving an area request, and for "Also update in Kōji" when editing a
# geofence. Example: http://127.0.0.1:8080
KOJI_URL=""

# Optional. Kōji's API secret. Sent with route generation and geofence creation, and
# used as the password for Kōji's admin login, which updating an existing
# geofence needs. Leave empty only if your Kōji has no secret.
KOJI_SECRET=""

# ── Spawnpoints (Golbat) ─────────────────────────────────────────────────────

# Optional. Golbat's database, for spawnpoint counts per area. Only read,
# never written, so a read-only user is enough. Leave empty and spawnpoint counts are off.
# Example: mysql://golbat_readonly:password@127.0.0.1:3306/golbat
GOLBAT_DATABASE_URL=""

# ── Discord alerts ───────────────────────────────────────────────────────────

# Optional. One Discord webhook that receives every alert. Leave empty for no
# alerts.
DISCORD_ALERT_WEBHOOK_URL=""

# Optional. Which events are posted to it: true to turn one on, anything else
# (including empty) is off.
# Someone submits a request to add or remove an area:
ALERT_AREA_REQUESTS="false"
# Someone adds or removes tokens on an area:
ALERT_TOKEN_CHANGES="false"
# A temporary area reaches its end date and is switched off:
ALERT_TEMP_AREA_EXPIRED="true"

# Optional. IANA time zone used to decide what "today" is for temporary-area
# start/end dates. Defaults to America/New_York; an invalid value logs a warning
# and falls back to the default.
TEMP_AREA_TIMEZONE=""

# Optional. A staticmap tileserver (Rampardos, or SwiftTileserverCache) that
# draws an area's map image for alerts and for the DM a user gets when their area
# request is resolved. It must have the `poracle-area` staticmap template.
# Leave empty and those messages have no image. Example: http://127.0.0.1:8090
STATIC_PROVIDER_URL=""
