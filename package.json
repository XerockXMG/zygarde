{
	"name": "zygarde",
	"version": "2.10.0",
	"description": "Area management and Discord community voting dashboard for Dragonite scanners",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/XerockXMG/zygarde.git"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node --env-file=.env build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"format": "prettier --write \"src/**/*.{ts,js,svelte,json}\" \"*.{js,ts,json}\"",
		"format:check": "prettier --check \"src/**/*.{ts,js,svelte,json}\" \"*.{js,ts,json}\""
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"mysql2": "^3.19.0",
		"pino": "^10.3.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^4",
		"@sveltejs/kit": "^2",
		"@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^22",
		"dotenv": "^17.4.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5",
		"svelte-check": "^3",
		"typescript": "^5",
		"vite": "^5",
		"vitest": "^2.1.9"
	}
}
